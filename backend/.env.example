# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

# Isolated PostgreSQL connection for Query Quest (must use the restricted qq_executor role!)
QUERY_QUEST_DATABASE_URL=postgresql://qq_executor:your-qq-executor-password@db.your-project.supabase.co:5432/postgres

# Auth
JWT_SECRET=change-this-to-a-random-64-char-hex-secret
ADMIN_PASSWORD=hey1234
